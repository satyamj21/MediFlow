<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>MediFlow – Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/mediflow.css">
  <style>
    /* Emergency alert banner */
    .emergency-alert-banner {
      display: none;
      background: linear-gradient(90deg, #7f1d1d, #dc2626);
      color: white; padding: 14px 20px; border-radius: var(--radius);
      margin-bottom: 18px; font-weight: 700; font-size: 13.5px;
      align-items: center; gap: 12px;
      box-shadow: 0 4px 16px rgba(220,38,38,0.3);
      animation: emergencySlide 0.4s ease;
    }
    .emergency-alert-banner.visible { display: flex; }
    .emergency-alert-banner svg { width: 18px; height: 18px; flex-shrink: 0; animation: shakePulse 0.8s ease-in-out infinite; }
    .emergency-alert-text { flex: 1; }
    .emergency-alert-text .emg-title { font-size: 14px; font-weight: 800; }
    .emergency-alert-text .emg-msg   { font-size: 12px; opacity: 0.85; margin-top: 3px; font-weight: 500; }
    .emergency-alert-time { font-size: 11px; opacity: 0.65; margin-left: auto; flex-shrink: 0; }
    @keyframes emergencySlide {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes shakePulse {
      0%, 100% { transform: rotate(0deg) scale(1); }
      25%       { transform: rotate(-10deg) scale(1.1); }
      75%       { transform: rotate(10deg) scale(1.1); }
    }
  </style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="logo-wrap"><%- icon('hospital') %></div>
    <span class="brand-name">MediFlow</span>
  </div>

  <div class="sidebar-section-label">Navigation</div>
  <nav>
    <a href="/user" class="active">
      <span class="nav-icon"><%- icon('dashboard') %></span> Dashboard
    </a>
    <a href="/book">
      <span class="nav-icon"><%- icon('calendar') %></span> Book Appointment
    </a>
    <a href="/appointments">
      <span class="nav-icon"><%- icon('appointments') %></span> My Appointments
    </a>
    <a href="/user/profile">
      <span class="nav-icon"><%- icon('profile') %></span> My Profile
    </a>
    <a href="/user/queue">
      <span class="nav-icon"><%- icon('queue') %></span> Live Queue
    </a>
  </nav>

  <div class="sidebar-spacer"></div>
  <div class="sidebar-divider"></div>

  <% if (typeof curruser !== 'undefined' && curruser) { %>
  <div class="sidebar-user">
    <div class="avatar"><%= curruser.username[0].toUpperCase() %></div>
    <div>
      <div class="user-name"><%= curruser.username %></div>
      <div class="user-role"><%= curruser.role %></div>
    </div>
  </div>
  <% } %>
  <form action="/logout" method="GET">
    <button class="logout-btn"><%- icon('logout') %> Logout</button>
  </form>
</aside>

<!-- MAIN -->
<main class="main">

  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="flash flash-success"><%- icon('success') %> <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="flash flash-error"><%- icon('warning') %> <%= error %></div>
  <% } %>

  <!-- Emergency Alert Banner (shown when emergency is active) -->
  <div class="emergency-alert-banner" id="emergencyBanner">
    <%- icon('emergency') %>
    <div class="emergency-alert-text">
      <div class="emg-title">⚠ EMERGENCY ALERT</div>
      <div class="emg-msg" id="emergencyMsg">Emergency Alert! Please follow staff instructions.</div>
    </div>
    <div class="emergency-alert-time" id="emergencyTime"></div>
  </div>

  <div class="page-header" style="display:flex; align-items:center; justify-content:space-between;">
    <div>
      <h1>Welcome back<% if(typeof curruser !== 'undefined' && curruser){ %>, <%= curruser.username %><% } %></h1>
      <p>Manage your hospital visits and appointments from here.</p>
    </div>
    <a href="/book" class="btn btn-primary btn-lg"><%- icon('plus') %> Book Appointment</a>
  </div>

  <!-- Quick action cards -->
  <div class="actions-grid">
    <a href="/book" class="action-card">
      <div class="ac-icon blue"><%- icon('calendar') %></div>
      <h3>Book Appointment</h3>
      <p>Schedule a visit with one of our available specialist doctors.</p>
    </a>
    <a href="/appointments" class="action-card">
      <div class="ac-icon yellow"><%- icon('appointments') %></div>
      <h3>My Appointments</h3>
      <p>View, reschedule or cancel your upcoming visits.</p>
    </a>
    <a href="/user/profile" class="action-card">
      <div class="ac-icon green"><%- icon('profile') %></div>
      <h3>My Profile</h3>
      <p>View your personal details, blood group, allergies and contact info.</p>
    </a>
  </div>

  <!-- Info bar -->
  <div style="margin-top:20px; background:linear-gradient(135deg,#0f3460,#1a56db); border-radius:var(--radius); padding:18px 24px; display:flex; align-items:center; justify-content:space-between; color:white;">
    <div>
      <div style="font-size:10px; opacity:0.6; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:4px;">Today</div>
      <div style="font-size:15px; font-weight:700;" id="today-date"></div>
    </div>
    <div style="text-align:center;">
      <div style="font-size:10px; opacity:0.6; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:4px;">Hospital Hours</div>
      <div style="font-size:13px; font-weight:600;">Mon – Sat &nbsp;·&nbsp; 9:00 AM – 6:00 PM</div>
    </div>
    <div style="text-align:right;">
      <div style="font-size:10px; opacity:0.6; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:4px;">Emergency</div>
      <div style="font-size:13px; font-weight:600; display:flex; align-items:center; gap:6px; justify-content:flex-end;">
        <%- icon('phone') %> 1800-MED-FLOW
      </div>
    </div>
  </div>

</main>

<script>
  document.getElementById('today-date').textContent = new Date().toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});

  // ── Emergency polling (every 5 seconds) ─────────────
  let lastEmergencyState = false;

  function checkEmergency() {
    fetch('/api/emergency/status')
      .then(r => r.json())
      .then(data => {
        const banner = document.getElementById('emergencyBanner');
        if (data.active) {
          document.getElementById('emergencyMsg').textContent = data.message || 'Emergency Alert! Please follow staff instructions.';
          if (data.triggeredAt) {
            const t = new Date(data.triggeredAt);
            document.getElementById('emergencyTime').textContent =
              'Since ' + t.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
          }
          if (!lastEmergencyState) {
            // Play alert sound if browser allows (optional, best-effort)
            try {
              const ctx = new AudioContext();
              const osc = ctx.createOscillator();
              osc.connect(ctx.destination);
              osc.frequency.value = 880;
              osc.start();
              osc.stop(ctx.currentTime + 0.4);
            } catch(e) {}
          }
          banner.classList.add('visible');
          lastEmergencyState = true;
        } else {
          banner.classList.remove('visible');
          lastEmergencyState = false;
        }
      })
      .catch(() => {});
  }

  checkEmergency(); // Check immediately on load
  setInterval(checkEmergency, 5000); // Then poll every 5 seconds

  // ── Action card entrance animation ─────────────────
  document.querySelectorAll('.action-card').forEach((card, i) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(14px)';
    card.style.transition = `opacity 0.32s ease ${i * 90}ms, transform 0.32s ease ${i * 90}ms`;
    requestAnimationFrame(() => { card.style.opacity = '1'; card.style.transform = 'translateY(0)'; });
  });
</script>
</body>
</html>
