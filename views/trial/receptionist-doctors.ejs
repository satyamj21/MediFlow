<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>MediFlow – Doctor Listing</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/mediflow.css">
  <style>
    .sidebar { background: linear-gradient(175deg, #0d6e6e 0%, #0e9090 100%); }
    .sidebar nav a.active { background: rgba(255,255,255,0.22); }

    .doctor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 18px;
    }

    .doctor-card {
      background: white;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 22px;
      border: 1.5px solid transparent;
      transition: all 0.22s ease;
      position: relative;
      overflow: hidden;
    }
    .doctor-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, #0d9488, #0e9090);
    }
    .doctor-card:hover {
      border-color: #0d9488;
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }

    .doc-avatar-wrap {
      display: flex; align-items: center; gap: 13px; margin-bottom: 16px;
    }
    .doc-avatar {
      width: 48px; height: 48px; border-radius: 50%;
      background: linear-gradient(135deg, #e0f7f7, #0e9090);
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; font-weight: 700; color: #0d6e6e; flex-shrink: 0;
    }
    .doc-name { font-size: 15px; font-weight: 700; color: var(--gray-900); }
    .doc-spec { font-size: 12px; color: #0d6e6e; font-weight: 600; margin-top: 2px; }

    .doc-info-row {
      display: flex; align-items: flex-start; gap: 8px;
      font-size: 12.5px; color: var(--gray-700); margin-bottom: 8px;
    }
    .doc-info-row .label {
      font-weight: 700; color: var(--gray-500); min-width: 70px; flex-shrink: 0;
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; padding-top: 1px;
    }

    .day-tags { display: flex; flex-wrap: wrap; gap: 5px; }
    .day-tag {
      padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 600;
      background: #e0f7f7; color: #0d6e6e;
    }
    .slot-tags { display: flex; flex-wrap: wrap; gap: 5px; }
    .slot-tag {
      padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 600;
      background: var(--blue-pale); color: var(--blue-dark);
    }

    .availability-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--green); display: inline-block; margin-right: 5px;
      animation: pulse-green 2s infinite;
    }
    @keyframes pulse-green {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(0.85); }
    }
  </style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="logo-wrap"><%- icon('hospital') %></div>
    <span class="brand-name">MediFlow</span>
  </div>
  <div class="sidebar-section-label">Reception</div>
  <nav>
    <a href="/receptionist"><span class="nav-icon"><%- icon('dashboard') %></span> Dashboard</a>
    <a href="/receptionist/queue"><span class="nav-icon"><%- icon('queue') %></span> Live Queue</a>
    <a href="/receptionist/appointments"><span class="nav-icon"><%- icon('appointments') %></span> Manage Appointments</a>
    <a href="/receptionist/patients"><span class="nav-icon"><%- icon('patients') %></span> Patients</a>
    <a href="/receptionist/add-patient"><span class="nav-icon"><%- icon('addpatient') %></span> Add Patient</a>
    <a href="/receptionist/doctors" class="active"><span class="nav-icon"><%- icon('doctor') %></span> Doctors</a>
    <a href="/receptionist/report"><span class="nav-icon"><%- icon('report') %></span> Daily Report</a>
  </nav>
  <div class="sidebar-spacer"></div>
  <div class="sidebar-divider"></div>
  <% if (typeof curruser !== 'undefined' && curruser) { %>
  <div class="sidebar-user">
    <div class="avatar"><%= curruser.username[0].toUpperCase() %></div>
    <div>
      <div class="user-name"><%= curruser.username %></div>
      <div class="user-role"><%= curruser.role %></div>
    </div>
  </div>
  <% } %>
  <form action="/logout" method="GET">
    <button class="logout-btn"><%- icon('logout') %> Logout</button>
  </form>
</aside>

<!-- MAIN -->
<main class="main">

  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="flash flash-success"><%- icon('success') %> <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="flash flash-error"><%- icon('warning') %> <%= error %></div>
  <% } %>

  <div class="page-header" style="display:flex; align-items:center; justify-content:space-between;">
    <div>
      <h1>Doctor Listing</h1>
      <p>All available doctors with their specializations and schedules.</p>
    </div>
    <div style="font-size:12.5px; color:var(--gray-500);">
      <span class="availability-dot"></span>
      <%= doctors.length %> doctor<%= doctors.length !== 1 ? 's' : '' %> on staff
    </div>
  </div>

  <% if (!doctors || doctors.length === 0) { %>
    <div class="card">
      <div class="empty-state">
        <div class="empty-icon"><%- icon('doctor') %></div>
        <h3>No doctors found</h3>
        <p>No doctors have been added to the system yet. Run the seed script to add sample doctors.</p>
      </div>
    </div>
  <% } else { %>
  <div class="doctor-grid">
    <% doctors.forEach(doc => { %>
    <div class="doctor-card">
      <div class="doc-avatar-wrap">
        <div class="doc-avatar"><%= doc.name[0].toUpperCase() %></div>
        <div>
          <div class="doc-name">Dr. <%= doc.name %></div>
          <div class="doc-spec"><%- icon('stethoscope') %> <%= doc.specialization %></div>
        </div>
      </div>

      <% if (doc.availableDays && doc.availableDays.length > 0) { %>
      <div class="doc-info-row">
        <span class="label">Days</span>
        <div class="day-tags">
          <% doc.availableDays.forEach(day => { %>
            <span class="day-tag"><%= day %></span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (doc.availableSlots && doc.availableSlots.length > 0) { %>
      <div class="doc-info-row">
        <span class="label">Slots</span>
        <div class="slot-tags">
          <% doc.availableSlots.forEach(slot => { %>
            <span class="slot-tag"><%- icon('clock') %> <%= slot %></span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <div style="margin-top:14px; padding-top:12px; border-top:1px solid var(--gray-100); display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:11.5px; color:var(--gray-400);">
          <span class="availability-dot" style="width:6px;height:6px;"></span>
          Available
        </span>
        <a href="/receptionist/report" class="btn btn-ghost btn-sm"><%- icon('report') %> View Report</a>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>

</main>

<script>
  // Stagger card entrance animations
  document.querySelectorAll('.doctor-card').forEach((card, i) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(18px)';
    card.style.transition = `opacity 0.35s ease ${i * 80}ms, transform 0.35s ease ${i * 80}ms`;
    requestAnimationFrame(() => {
      card.style.opacity = '1';
      card.style.transform = 'translateY(0)';
    });
  });
</script>
</body>
</html>
