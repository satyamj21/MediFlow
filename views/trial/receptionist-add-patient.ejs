<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>MediFlow – Add Patient</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/mediflow.css">
  <style>
    .sidebar { background: linear-gradient(175deg, #0d6e6e 0%, #0e9090 100%); }
    .sidebar nav a.active { background: rgba(255,255,255,0.22); }
    .stat-icon.teal { background: #e0f7f7; color: #0d6e6e; }
    .form-section-title {
      font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--gray-500);
      margin: 22px 0 12px; padding-bottom: 6px;
      border-bottom: 1px solid var(--gray-100);
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  </style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="logo-wrap"><%- icon('hospital') %></div>
    <span class="brand-name">MediFlow</span>
  </div>

  <div class="sidebar-section-label">Reception</div>
  <nav>
    <a href="/receptionist"><span class="nav-icon"><%- icon('dashboard') %></span> Dashboard</a>
    <a href="/receptionist/queue"><span class="nav-icon"><%- icon('queue') %></span> Live Queue</a>
    <a href="/receptionist/appointments"><span class="nav-icon"><%- icon('appointments') %></span> Manage Appointments</a>
    <a href="/receptionist/patients"><span class="nav-icon"><%- icon('patients') %></span> Patients</a>
    <a href="/receptionist/add-patient" class="active"><span class="nav-icon"><%- icon('addpatient') %></span> Add Patient</a>
    <a href="/receptionist/doctors"><span class="nav-icon"><%- icon('doctor') %></span> Doctors</a>
    <a href="/receptionist/report"><span class="nav-icon"><%- icon('report') %></span> Daily Report</a>
  </nav>

  <div class="sidebar-spacer"></div>
  <div class="sidebar-divider"></div>

  <% if (typeof curruser !== 'undefined' && curruser) { %>
  <div class="sidebar-user">
    <div class="avatar"><%= curruser.username[0].toUpperCase() %></div>
    <div>
      <div class="user-name"><%= curruser.username %></div>
      <div class="user-role"><%= curruser.role %></div>
    </div>
  </div>
  <% } %>
  <form action="/logout" method="GET">
    <button class="logout-btn"><%- icon('logout') %> Logout</button>
  </form>
</aside>

<!-- MAIN -->
<main class="main">

  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="flash flash-success"><%- icon('success') %> <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="flash flash-error"><%- icon('warning') %> <%= error %></div>
  <% } %>

  <div class="page-header" style="display:flex; align-items:center; justify-content:space-between;">
    <div>
      <h1>Add New Patient</h1>
      <p>Register a new patient account with full profile details.</p>
    </div>
    <a href="/receptionist/patients" class="btn btn-ghost"><%- icon('back') %> All Patients</a>
  </div>

  <div class="card">
    <div class="card-body">
      <form action="/receptionist/add-patient" method="POST" id="addPatientForm" novalidate>

        <div class="form-section-title">Account Credentials</div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Username *</label>
            <input class="form-control" type="text" name="username" required placeholder="e.g. john_doe" autocomplete="off">
            <div class="field-error" id="err-username">Username is required.</div>
          </div>
          <div class="form-group">
            <label class="form-label">Email Address *</label>
            <input class="form-control" type="email" name="email" required placeholder="e.g. john@email.com">
            <div class="field-error" id="err-email">Valid email is required.</div>
          </div>
        </div>
        <div class="form-group" style="max-width:300px;">
          <label class="form-label">Temporary Password *</label>
          <input class="form-control" type="password" name="password" required placeholder="Min 9 chars, 1 uppercase, 1 special (@#%^&*()!)">
          <div class="field-error" id="err-password">Password must be >8 chars, 1 uppercase, 1 special (@#%^&*()!).</div>
        </div>

        <div class="form-section-title">Personal Information</div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name</label>
            <input class="form-control" type="text" name="fullName" placeholder="e.g. John Michael Doe">
          </div>
          <div class="form-group">
            <label class="form-label">Gender</label>
            <select class="form-control" name="gender">
              <option value="">Select gender</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
              <option value="Prefer not to say">Prefer not to say</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Age</label>
            <input class="form-control" type="number" name="age" min="0" max="150" placeholder="e.g. 32">
          </div>
          <div class="form-group">
            <label class="form-label">Blood Group</label>
            <select class="form-control" name="bloodGroup">
              <option value="">Select blood group</option>
              <option value="A+">A+</option>
              <option value="A-">A-</option>
              <option value="B+">B+</option>
              <option value="B-">B-</option>
              <option value="AB+">AB+</option>
              <option value="AB-">AB-</option>
              <option value="O+">O+</option>
              <option value="O-">O-</option>
              <option value="Unknown">Unknown</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Known Allergies</label>
          <input class="form-control" type="text" name="allergies" placeholder="e.g. Penicillin, Peanuts (or 'None')">
        </div>

        <div class="form-section-title">Contact Information</div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Personal Phone</label>
            <input class="form-control" type="tel" name="phone" placeholder="e.g. +91 98765 43210">
          </div>
          <div class="form-group">
            <label class="form-label">Emergency Contact Name</label>
            <input class="form-control" type="text" name="emergencyContactName" placeholder="e.g. Jane Doe (Wife)">
          </div>
        </div>
        <div class="form-group" style="max-width:300px;">
          <label class="form-label">Emergency Contact Phone</label>
          <input class="form-control" type="tel" name="emergencyContactPhone" placeholder="e.g. +91 91234 56789">
        </div>

        <div style="margin-top:24px; display:flex; gap:10px;">
          <button type="submit" class="btn btn-primary btn-lg"><%- icon('addpatient') %> Register Patient</button>
          <a href="/receptionist/patients" class="btn btn-ghost btn-lg">Cancel</a>
        </div>

      </form>
    </div>
  </div>

</main>

<script>
  document.getElementById('addPatientForm').addEventListener('submit', function(e) {
    let valid = true;
    const username = this.querySelector('[name="username"]');
    const email    = this.querySelector('[name="email"]');
    const password = this.querySelector('[name="password"]');

    [username, email, password].forEach(f => f.classList.remove('error'));
    ['err-username','err-email','err-password'].forEach(id => document.getElementById(id).classList.remove('show'));

    if (!username.value.trim()) {
      username.classList.add('error');
      document.getElementById('err-username').classList.add('show');
      valid = false;
    }
    if (!email.value.trim() || !email.validity.valid) {
      email.classList.add('error');
      document.getElementById('err-email').classList.add('show');
      valid = false;
    }
    const passRegex = /^(?=.*[A-Z])(?=.*[@#%\^&\*\(\)!]).{9,}$/;
    if (!password.value || !passRegex.test(password.value)) {
      password.classList.add('error');
      document.getElementById('err-password').classList.add('show');
      valid = false;
    }
    if (!valid) e.preventDefault();
  });

  // Animate inputs on focus
  document.querySelectorAll('.form-control').forEach(el => {
    el.addEventListener('focus', () => el.style.transform = 'scale(1.005)');
    el.addEventListener('blur', () => el.style.transform = 'scale(1)');
  });
</script>
</body>
</html>
