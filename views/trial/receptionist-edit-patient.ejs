<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>MediFlow – Edit Patient</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/mediflow.css">
  <style>
    .sidebar { background: linear-gradient(175deg, #0d6e6e 0%, #0e9090 100%); }
    .sidebar nav a.active { background: rgba(255,255,255,0.22); }
    .form-section-title {
      font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--gray-500);
      margin: 22px 0 12px; padding-bottom: 6px;
      border-bottom: 1px solid var(--gray-100);
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .patient-header {
      display: flex; align-items: center; gap: 14px;
      background: linear-gradient(135deg, #e0f7f7, #f0fdfa);
      border: 1px solid #b2e0e0; border-radius: var(--radius);
      padding: 14px 18px; margin-bottom: 24px;
    }
    .patient-header .big-avatar {
      width: 44px; height: 44px; border-radius: 50%;
      background: linear-gradient(135deg, #0e9090, #0d6e6e);
      color: white; display: flex; align-items: center; justify-content: center;
      font-size: 18px; font-weight: 700; flex-shrink: 0;
    }
  </style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="logo-wrap"><%- icon('hospital') %></div>
    <span class="brand-name">MediFlow</span>
  </div>
  <div class="sidebar-section-label">Reception</div>
  <nav>
    <a href="/receptionist"><span class="nav-icon"><%- icon('dashboard') %></span> Dashboard</a>
    <a href="/receptionist/queue"><span class="nav-icon"><%- icon('queue') %></span> Live Queue</a>
    <a href="/receptionist/appointments"><span class="nav-icon"><%- icon('appointments') %></span> Manage Appointments</a>
    <a href="/receptionist/patients" class="active"><span class="nav-icon"><%- icon('patients') %></span> Patients</a>
    <a href="/receptionist/add-patient"><span class="nav-icon"><%- icon('addpatient') %></span> Add Patient</a>
    <a href="/receptionist/doctors"><span class="nav-icon"><%- icon('doctor') %></span> Doctors</a>
    <a href="/receptionist/report"><span class="nav-icon"><%- icon('report') %></span> Daily Report</a>
  </nav>
  <div class="sidebar-spacer"></div>
  <div class="sidebar-divider"></div>
  <% if (typeof curruser !== 'undefined' && curruser) { %>
  <div class="sidebar-user">
    <div class="avatar"><%= curruser.username[0].toUpperCase() %></div>
    <div>
      <div class="user-name"><%= curruser.username %></div>
      <div class="user-role"><%= curruser.role %></div>
    </div>
  </div>
  <% } %>
  <form action="/logout" method="GET">
    <button class="logout-btn"><%- icon('logout') %> Logout</button>
  </form>
</aside>

<!-- MAIN -->
<main class="main">

  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="flash flash-success"><%- icon('success') %> <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="flash flash-error"><%- icon('warning') %> <%= error %></div>
  <% } %>

  <div class="page-header" style="display:flex; align-items:center; justify-content:space-between;">
    <div>
      <h1>Edit Patient Details</h1>
      <p>Update profile information for this patient.</p>
    </div>
    <a href="/receptionist/patients" class="btn btn-ghost"><%- icon('back') %> Back to Patients</a>
  </div>

  <div class="card">
    <div class="card-body">

      <!-- Patient identity banner -->
      <div class="patient-header">
        <div class="big-avatar"><%= (patient.fullName || patient.username)[0].toUpperCase() %></div>
        <div>
          <div style="font-size:15px; font-weight:700; color:var(--gray-900);"><%= patient.fullName || patient.username %></div>
          <div style="font-size:12px; color:var(--gray-500);">@<%= patient.username %> &nbsp;·&nbsp; <%= patient.email %></div>
        </div>
      </div>

      <form action="/receptionist/patients/<%= patient._id %>/edit" method="POST">

        <div class="form-section-title">Personal Information</div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name</label>
            <input class="form-control" type="text" name="fullName" value="<%= patient.fullName || '' %>" placeholder="Full legal name">
          </div>
          <div class="form-group">
            <label class="form-label">Email Address</label>
            <input class="form-control" type="email" name="email" value="<%= patient.email || '' %>" placeholder="email@example.com">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Gender</label>
            <select class="form-control" name="gender">
              <option value="">Select gender</option>
              <% ['Male','Female','Other','Prefer not to say'].forEach(g => { %>
                <option value="<%= g %>" <%= patient.gender === g ? 'selected' : '' %>><%= g %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Age</label>
            <input class="form-control" type="number" name="age" min="0" max="150" value="<%= patient.age || '' %>" placeholder="e.g. 32">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Blood Group</label>
            <select class="form-control" name="bloodGroup">
              <option value="">Select blood group</option>
              <% ['A+','A-','B+','B-','AB+','AB-','O+','O-','Unknown'].forEach(bg => { %>
                <option value="<%= bg %>" <%= patient.bloodGroup === bg ? 'selected' : '' %>><%= bg %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Known Allergies</label>
            <input class="form-control" type="text" name="allergies" value="<%= patient.allergies || '' %>" placeholder="e.g. Penicillin, Peanuts">
          </div>
        </div>

        <div class="form-section-title">Contact Information</div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Personal Phone</label>
            <input class="form-control" type="tel" name="phone" value="<%= patient.phone || '' %>" placeholder="e.g. +91 98765 43210">
          </div>
          <div class="form-group">
            <label class="form-label">Emergency Contact Name</label>
            <input class="form-control" type="text" name="emergencyContactName" value="<%= patient.emergencyContactName || '' %>" placeholder="e.g. Jane Doe">
          </div>
        </div>
        <div class="form-group" style="max-width:300px;">
          <label class="form-label">Emergency Contact Phone</label>
          <input class="form-control" type="tel" name="emergencyContactPhone" value="<%= patient.emergencyContactPhone || '' %>" placeholder="e.g. +91 91234 56789">
        </div>

        <div style="margin-top:24px; display:flex; gap:10px;">
          <button type="submit" class="btn btn-primary btn-lg"><%- icon('check') %> Save Changes</button>
          <a href="/receptionist/patients" class="btn btn-ghost btn-lg">Cancel</a>
        </div>

      </form>
    </div>
  </div>

</main>
</body>
</html>
