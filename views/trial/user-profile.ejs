<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>MediFlow – My Profile</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/mediflow.css">
  <style>
    .profile-hero {
      background: linear-gradient(135deg, #0f3460, #1a56db);
      border-radius: var(--radius); padding: 28px 30px; color: white;
      display: flex; align-items: center; gap: 20px; margin-bottom: 22px;
      box-shadow: 0 6px 24px rgba(15,52,96,0.2);
      animation: fadeInUp 0.4s ease;
    }
    .profile-hero-avatar {
      width: 68px; height: 68px; border-radius: 50%;
      background: rgba(255,255,255,0.22); border: 3px solid rgba(255,255,255,0.4);
      display: flex; align-items: center; justify-content: center;
      font-size: 28px; font-weight: 800; flex-shrink: 0;
    }
    .profile-hero-name { font-size: 22px; font-weight: 800; letter-spacing: -0.3px; }
    .profile-hero-sub  { font-size: 13px; opacity: 0.7; margin-top: 4px; }
    .profile-hero-tag  {
      margin-top: 10px; background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.3);
      border-radius: 999px; padding: 4px 14px; font-size: 11.5px; font-weight: 600;
      display: inline-block;
    }

    .profile-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    }
    .profile-section {
      background: white; border-radius: var(--radius);
      box-shadow: var(--shadow); padding: 20px 22px;
      animation: fadeInUp 0.4s ease;
    }
    .profile-section.full { grid-column: 1 / -1; }
    .profile-section h3 {
      font-size: 12px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--gray-500);
      margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid var(--gray-100);
    }

    .profile-row {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 9px 0; border-bottom: 1px solid var(--gray-100);
    }
    .profile-row:last-child { border-bottom: none; }
    .profile-row .pr-label {
      min-width: 140px; font-size: 11.5px; font-weight: 700;
      color: var(--gray-400); text-transform: uppercase; letter-spacing: 0.05em;
      flex-shrink: 0; padding-top: 2px;
    }
    .profile-row .pr-value {
      font-size: 13.5px; font-weight: 600; color: var(--gray-900); word-break: break-word;
    }
    .profile-row .pr-value.empty {
      color: var(--gray-300); font-weight: 400; font-style: italic;
    }

    .blood-chip {
      display: inline-block; background: #fee2e2; color: #991b1b;
      padding: 3px 11px; border-radius: 999px; font-weight: 800; font-size: 13px;
    }
    .allergy-chip {
      display: inline-block; background: var(--yellow-pale); color: #92400e;
      padding: 3px 11px; border-radius: 999px; font-size: 12px; font-weight: 600;
    }
    .gender-chip {
      display: inline-block; background: var(--blue-pale); color: var(--blue-dark);
      padding: 3px 11px; border-radius: 999px; font-size: 12px; font-weight: 600;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="logo-wrap"><%- icon('hospital') %></div>
    <span class="brand-name">MediFlow</span>
  </div>
  <div class="sidebar-section-label">Navigation</div>
  <nav>
    <a href="/user"><span class="nav-icon"><%- icon('dashboard') %></span> Dashboard</a>
    <a href="/book"><span class="nav-icon"><%- icon('calendar') %></span> Book Appointment</a>
    <a href="/appointments"><span class="nav-icon"><%- icon('appointments') %></span> My Appointments</a>
    <a href="/user/profile" class="active"><span class="nav-icon"><%- icon('profile') %></span> My Profile</a>
    <a href="/user/queue"><span class="nav-icon"><%- icon('queue') %></span> Live Queue</a>
  </nav>
  <div class="sidebar-spacer"></div>
  <div class="sidebar-divider"></div>
  <% if (typeof curruser !== 'undefined' && curruser) { %>
  <div class="sidebar-user">
    <div class="avatar"><%= curruser.username[0].toUpperCase() %></div>
    <div>
      <div class="user-name"><%= curruser.username %></div>
      <div class="user-role"><%= curruser.role %></div>
    </div>
  </div>
  <% } %>
  <form action="/logout" method="GET">
    <button class="logout-btn"><%- icon('logout') %> Logout</button>
  </form>
</aside>

<!-- MAIN -->
<main class="main">

  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="flash flash-success"><%- icon('success') %> <%= success %></div>
  <% } %>

  <!-- Hero banner -->
  <div class="profile-hero">
    <div class="profile-hero-avatar">
      <%= (patient.fullName || patient.username)[0].toUpperCase() %>
    </div>
    <div>
      <div class="profile-hero-name"><%= patient.fullName || patient.username %></div>
      <div class="profile-hero-sub">@<%= patient.username %> &nbsp;·&nbsp; <%= patient.email %></div>
      <span class="profile-hero-tag">Patient</span>
    </div>
  </div>

  <div class="profile-grid">

    <!-- Personal Information -->
    <div class="profile-section">
      <h3>Personal Information</h3>

      <div class="profile-row">
        <span class="pr-label">Full Name</span>
        <span class="pr-value <%= !patient.fullName ? 'empty' : '' %>">
          <%= patient.fullName || 'Not provided' %>
        </span>
      </div>
      <div class="profile-row">
        <span class="pr-label">Gender</span>
        <span class="pr-value">
          <% if (patient.gender) { %>
            <span class="gender-chip"><%= patient.gender %></span>
          <% } else { %>
            <span class="empty">Not provided</span>
          <% } %>
        </span>
      </div>
      <div class="profile-row">
        <span class="pr-label">Age</span>
        <span class="pr-value <%= !patient.age ? 'empty' : '' %>">
          <%= patient.age ? patient.age + ' years' : 'Not provided' %>
        </span>
      </div>
      <div class="profile-row">
        <span class="pr-label">Blood Group</span>
        <span class="pr-value">
          <% if (patient.bloodGroup) { %>
            <span class="blood-chip"><%= patient.bloodGroup %></span>
          <% } else { %>
            <span class="empty">Not provided</span>
          <% } %>
        </span>
      </div>
      <div class="profile-row">
        <span class="pr-label">Allergies</span>
        <span class="pr-value">
          <% if (patient.allergies) { %>
            <span class="allergy-chip"><%= patient.allergies %></span>
          <% } else { %>
            <span class="empty">None recorded</span>
          <% } %>
        </span>
      </div>
    </div>

    <!-- Contact Information -->
    <div class="profile-section">
      <h3>Contact Information</h3>

      <div class="profile-row">
        <span class="pr-label">Email</span>
        <span class="pr-value <%= !patient.email ? 'empty' : '' %>">
          <%= patient.email || 'Not provided' %>
        </span>
      </div>
      <div class="profile-row">
        <span class="pr-label">Phone</span>
        <span class="pr-value <%= !patient.phone ? 'empty' : '' %>">
          <% if (patient.phone) { %>
            <%- icon('phone') %>&nbsp;<%= patient.phone %>
          <% } else { %>
            Not provided
          <% } %>
        </span>
      </div>
      <div class="profile-row">
        <span class="pr-label">Emergency Contact</span>
        <span class="pr-value <%= !patient.emergencyContactName ? 'empty' : '' %>">
          <%= patient.emergencyContactName || 'Not provided' %>
        </span>
      </div>
      <div class="profile-row">
        <span class="pr-label">Emergency Phone</span>
        <span class="pr-value <%= !patient.emergencyContactPhone ? 'empty' : '' %>">
          <% if (patient.emergencyContactPhone) { %>
            <%- icon('phone') %>&nbsp;<%= patient.emergencyContactPhone %>
          <% } else { %>
            Not provided
          <% } %>
        </span>
      </div>
    </div>

  </div>

  <div style="margin-top: 16px; display:flex; gap:10px;">
    <a href="/user" class="btn btn-ghost"><%- icon('back') %> Back to Dashboard</a>
    <a href="/user/profile/edit" class="btn btn-warning"><%- icon('edit') %> Edit Profile</a>
    <a href="/book" class="btn btn-primary"><%- icon('calendar') %> Book Appointment</a>
  </div>

</main>
</body>
</html>
